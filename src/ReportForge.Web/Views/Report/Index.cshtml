@model ReportPageViewModel

@{
    ViewData["Title"] = "Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">ReportForge</h1>
    @if (Model.HasData)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv">Export CSV</a>
            <form asp-action="Reset" method="post" onsubmit="return confirm('Clear all data and start over?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">Reset</button>
            </form>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (!Model.HasData)
{
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 card-title">Paste your CSV data</h2>
            <p class="text-muted">Columns: <code>Date, Category, Description, Amount</code>. A header row is optional.</p>
            <form asp-action="Generate" method="post">
                @Html.AntiForgeryToken()
                <textarea name="pasteText" class="form-control mb-3" rows="10"
                          placeholder="2025-01-05,Software,Cloud hosting,120.00">@Model.PasteText</textarea>
                <button type="submit" class="btn btn-primary">Generate report</button>
            </form>
            <hr />
            <form asp-action="LoadSample" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link px-0">Load sample data instead</button>
            </form>
        </div>
    </div>
}
else
{
    var report = Model.Report!;

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total amount</div>
                    <div class="fs-4 fw-semibold">@report.TotalAmount.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Records</div>
                    <div class="fs-4 fw-semibold">@report.RecordCount</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Average</div>
                    <div class="fs-4 fw-semibold">@report.AverageAmount.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Date range</div>
                    <div class="fs-6 fw-semibold">
                        @report.StartDate.ToString("MMM d, yyyy") &ndash; @report.EndDate.ToString("MMM d, yyyy")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">Top categories</h2>
                    <ol class="list-group list-group-numbered">
                        @foreach (var category in report.TopCategories)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @category.Category
                                <span class="badge text-bg-primary rounded-pill">@category.Total.ToString("C")</span>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">Range</h2>
                    <div class="text-muted small">Min amount</div>
                    <div class="fw-semibold mb-2">@report.MinAmount.ToString("C")</div>
                    <div class="text-muted small">Max amount</div>
                    <div class="fw-semibold">@report.MaxAmount.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 card-title">Breakdown by category</h2>
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Records</th>
                        <th>Total</th>
                        <th style="width: 40%">Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in report.CategorySummaries)
                    {
                        <tr>
                            <td>@category.Category</td>
                            <td>@category.Count</td>
                            <td>@category.Total.ToString("C")</td>
                            <td>
                                <div class="progress" role="progressbar"
                                     aria-valuenow="@category.PercentageOfTotal" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" style="width: @(category.PercentageOfTotal)%">
                                        @category.PercentageOfTotal%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 card-title">Paste more data</h2>
            <p class="text-muted">Appends to the current dataset and regenerates the report.</p>
            <form asp-action="Append" method="post">
                @Html.AntiForgeryToken()
                <textarea name="pasteText" class="form-control mb-3" rows="6"
                          placeholder="2025-03-01,Software,Cloud hosting,120.00">@Model.PasteText</textarea>
                <button type="submit" class="btn btn-primary">Append &amp; regenerate</button>
            </form>
        </div>
    </div>
}
